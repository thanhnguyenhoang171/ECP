# ==========================================
# ECP ADMIN - ENVIRONMENT VARIABLES EXAMPLE
# ==========================================

# Backend Java API URL (Internal network / Server-side)
ADMIN_INTERNAL_API_URL=http://localhost:9090/api
INTERNAL_API_URL=http://localhost:9090/api

# Backend Java API URL (Public / Client-side)
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:9090/api
NEXT_PUBLIC_API_URL=http://localhost:9090/api

# Frontend Admin URL (Tùy chọn, dùng khi SSR gọi route handler của Admin)
NEXT_PUBLIC_APP_URL=http://localhost:8081

# Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Port chạy ứng dụng (Mặc định dev: 3001, docker/production: 8081)
PORT=3001

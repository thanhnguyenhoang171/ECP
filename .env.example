# ==========================================
# DOCKER COMPOSE CONFIGURATION (ECP)
# ==========================================

# Database MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/dev_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=142857
MYSQL_ROOT_PASSWORD=142857
MYSQL_DATABASE=dev_db
MYSQL_USER=root
MYSQL_PASSWORD=142857

# MongoDB
SPRING_MONGODB_URI=mongodb://mongodocker:142857@localhost:27018/ecp_mongo?authSource=admin
MONGO_ROOT_USER=mongodocker
MONGO_ROOT_PASSWORD=142857

# Redis Cache
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6380
SPRING_REDIS_USERNAME=
SPRING_REDIS_PASSWORD=142857

# Security & JWT
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_length_here_1234567890
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_DDL_AUTO=update

# Storage Providers (MinIO S3 & Cloudinary)
MINIO_SERVICE_ENABLE=true
CLOUDINARY_SERVICE_ENABLE=false

# MinIO S3 Storage
MINIO_ENDPOINT=172.17.0.1:9050
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=ecp-media
MINIO_PUBLIC_URL=

# Cloudinary (nếu bật CLOUDINARY_SERVICE_ENABLE=true)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Swagger
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=swagger@123

# Telegram Alert Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Service
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Frontend Endpoints & OAuth
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:9091/api
NEXT_PUBLIC_STOREFRONT_API_URL=/api
STOREFRONT_INTERNAL_API_URL=http://api:9090/api
INTERNAL_API_URL=http://api:9090/api
NEXT_PUBLIC_API_URL=http://localhost:9091/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
